<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Frontend del sitio web: el boton de apps (grilla, arriba a la izquierda,
        o_frontend_to_backend_apps_btn) en Odoo 19 estandar abre un menu
        desplegable con la lista de aplicaciones. Como parte del debrand lo
        hacemos navegar directamente al home del backend (/odoo), la pantalla
        con los iconos de las apps, en lugar de desplegar el menu.

        Cambio aditivo y reversible: solo hereda website.layout, no toca core.
    -->
    <template id="frontend_apps_btn_to_home" inherit_id="website.layout"
              name="Trixocom Debrand: boton apps abre el home de iconos">
        <xpath expr="//a[hasclass('o_frontend_to_backend_apps_btn')]" position="attributes">
            <attribute name="href">/odoo</attribute>
            <attribute name="data-bs-toggle"/>
        </xpath>
        <xpath expr="//div[hasclass('o_frontend_to_backend_apps_menu')]" position="replace"/>
    </template>

    <!--
        website.brand_promotion (website/views/website_templates.xml:354)
        reemplaza el t-call a web.brand_promotion_message agregando:

            <t t-set="_message">
                Create a <a href="http://www.odoo.com/app/website?...">free
                website</a>
            </t>

        El "Powered by <marca>" en si ya lo cubre webclient_templates.xml
        (override de web.brand_promotion_message), pero ese _message queda
        colgado con el link a odoo.com. Lo vaciamos.

        Se hereda website.brand_promotion (y no web.brand_promotion) a
        proposito: si website.brand_promotion se desactivara, este inherit
        tampoco se aplica y el XPath no falla por nodo inexistente.
    -->
    <template id="brand_promotion_debrand"
              inherit_id="website.brand_promotion"
              name="Trixocom Debrand: Website Brand Promotion">
        <xpath expr="//t[@t-set='_message']" position="replace">
            <t t-set="_message"/>
        </xpath>
    </template>

    <!--
        website.show_website_info (website/views/website_templates.xml:2728)
        es la pagina /website/info. Trae tres referencias a Odoo:

        1. <small groups="base.group_no_one">Odoo Version <version></small>
        2. "Information about the <company> instance of Odoo, the
           <a href="https://www.odoo.com">Open Source ERP</a>."
        3. Fallback del link de las localizaciones instaladas:
           app.website or 'https://www.odoo.com/app/accounting/' + app.name
    -->
    <template id="show_website_info_debrand"
              inherit_id="website.show_website_info"
              name="Trixocom Debrand: Website Info">
        <xpath expr="//small[@groups='base.group_no_one']" position="replace">
            <small groups="base.group_no_one">Version <t t-out="version.get('server_version')"/></small>
        </xpath>
        <xpath expr="//a[hasclass('o_translate_inline')]/.." position="replace">
            <!-- Frase entera antes del t-out para que el msgid sea uno solo
                 ("Information about this instance of") y no dos fragmentos
                 sueltos imposibles de traducir con sentido. -->
            <p>Information about this instance of <t t-out="res_company.name"/>.</p>
        </xpath>
        <xpath expr="//a[contains(@t-att-href, 'odoo.com')]" position="attributes">
            <!-- Sin website propio el <a> queda sin href: QWeb omite el
                 atributo cuando el valor es falsy y renderiza solo el texto. -->
            <attribute name="t-att-href">app.website or ''</attribute>
        </xpath>
    </template>

</odoo>
